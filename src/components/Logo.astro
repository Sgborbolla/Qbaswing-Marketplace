---
/**
 * Logotipo de QBASwing.
 *
 * ============================================================================
 *  POR QUE ESTE COMPONENTE EXISTE
 * ============================================================================
 * El mismo archivo se usa en cuatro lugares y a cuatro escalas: cabecera
 * (40 px), pie (32 px), pagina 404 (96 px) y favicon. Si cada sitio escribiera
 * su propio <img>, cambiar la ruta o el texto alternativo seria una edicion en
 * cuatro archivos, y es exactamente el tipo de duplication que produjo los 43
 * `data-alt` de los mockups de Stitch (atributo que no existe en HTML y por lo
 * tanto no llenaba el `alt`).
 *
 * ============================================================================
 *  SOBRE EL ARCHIVO
 * ============================================================================
 * public/logo-qbaswing.webp — 512x512 px, 56 KB. Lo genera `scripts/logo.mjs` a
 * partir de `logotipo 2.jpg`, que es la unica copia de la artwork y no se
 * toca nunca.
 *
 * Antes era `logo-qbaswing.png`, un PNG de 1024x1024 con canal alfa y 1.6 MB,
 * para un logo que se ve a 32, 40 y 96 px. Son 30 veces mas bytes de los
 * necesarios, y esos bytes se piden ANTES de que la cabecera se painted: en
 * una conexion Cubanaseficiente el logo era lo primero que retrasaba la pagina.
 *
 * 512 px es el tamano justo: el uso mayor es 96 px, y a densidad 3 eso son 288
 * px reales. 512 da margen sin que un telefono descargue mas pixeles de los que
 * puede mostrar.
 *
 * Un detalle del original: es un JPG, o sea que NO tiene fondo transparente.
 * El anterior si lo tenia. Sobre el pie, que es oscuro, este logo se vera como
 * un cuadrado gris claro. Si molesta, lo que hay que hacer es recortar el fondo
 * en el original y volver a correr `npm run logo`; no se recorta aqui, porque
 * `object-contain` recorta al vuelo y deja el borde del rectangulo.
 *
 * NO se reescala ni se convierte aca: la recompresion es irreversible y el
 * original es la fuente de verdad. El dimensionado lo hace el navegador con
 * width/height.
 */
interface Props {
  /**
   * Alto en px. El ancho se deriva del aspect ratio real del archivo, que es
   * 1:1, asi que solo hay que declarar una dimension.
   */
  altura?: number
  /**
   * Ruta alternativa, para cuando exista un asset optimizado.
   * Por defecto, el logo provisto.
   */
  fuente?: string
  /**
   * Texto alternativo. `''` lo marca como decorativo y lo omite de la
   * accesibilidad: solo corresponde cuando el nombre de la marca ya esta escrito
   * al lado, como en la cabecera. En el pie y el 404, donde el nombre no esta,
   * el valor por defecto es el nombre completo.
   */
  alt?: string
  /** Anima la aparicion. Se usa en el 404, que aparece sin contexto previo. */
  prioritario?: boolean
}

const {
  altura = 40,
  fuente = '/logo-qbaswing.webp',
  alt = 'QBASwing Marketplace',
  prioritario = false,
} = Astro.props

// Intrinseco del archivo. Declarar width y height evita el desplazamiento de
// contenido (CLS): el navegador reserva el espacio antes de descargar la imagen.
//
// Son 512, los del `.webp` que genera `scripts/logo.mjs`. Van juntos a proposito:
// si el archivo se cambia de tamano hay que cambiar estos dos numeros, y un 512
// puesto sobre una imagen de 1024 reserva el doble de alto y empuja el contenido
// de la pagina hacia abajo mientras carga.
const ANCHO_NATURAL = 512
const ALTO_NATURAL = 512
---

{/*
  `alt=""` es valido y correcto para imagen decorativa; el problema de los
  mockups fue no tener alt en absoluto. Este ternario deja explicita la
  diferencia entre "sin descripcion porque el texto ya esta al lado" y
  "necesita descripcion".
*/}
<img
  src={fuente}
  alt={alt}
  width={ALTO_NATURAL}
  height={ALTO_NATURAL}
  style={`height:${altura}px; width:auto;`}
  decoding={prioritario ? 'sync' : 'async'}
  fetchpriority={prioritario ? 'high' : 'auto'}
  class="shrink-0 object-contain select-none"
/>
