---
/**
 * Cabecera del sitio.
 *
 * ============================================================================
 *  POR QUE NO HAY UN COMPONENTE <Logo> SEPARADO
 * ============================================================================
 * El logo aparece en tres lugares (esta cabecera, el pie y la pagina 404) con
 * tamanos muy distintos: 40 px en la cabecera, 32 px en el pie, 96 px en el 404.
 * Si el marcado se duplica en cada uno, cambiar el camino del archivo o el
 * texto alternativo significa editar tres archivos. El `Logo.astro` centraliza
 * las tres cosas que nunca deben cambiar: la ruta, las dimensiones intrinsecas
 * y el texto alternativo. El tamano lo decide cada sitio.
 *
 * NOTA SOBRE EL ALTERNATIVO: los mockups de Stitch usaban `data-alt` en lugar
 * de `alt` en las 43 imagenes, lo que deja el logo sin descripcion para lectores
 * de pantalla. Aqui el `alt` es obligatorio y no decorativo.
 */
import Logo from '../Logo.astro'
import SelectorIdioma from '../SelectorIdioma.astro'
import BotonCerrarSesion from '../BotonCerrarSesion.astro'

/** Enlaces de navegacion principal. Rutas de referencia: se crean con las 16
 *  paginas del plan. Hoy apuntan a rutas que todavia no existen, y por eso el
 *  sitio entrega un 404 real en vez de un placeholder. */
const NAVEGACION = [
  { href: '/productos', etiqueta: 'Productos' },
  { href: '/espacios', etiqueta: 'Espacios' },
  { href: '/vender', etiqueta: 'Vender' },
]

/** Rutas con `data-alt` en los mockups y nombre de icono Material equivalente. */
const ICONO = {
  buscar: 'search',
  carrito: 'shopping_cart',
  cuenta: 'account_circle',
  menu: 'menu',
  cerrar: 'close',
} as const
---

<header
  class="sticky top-0 z-40 w-full border-b border-outline-variant/40 bg-surface/85 backdrop-blur-md supports-[backdrop-filter]:bg-surface/70"
>
  <div class="container-page flex h-16 items-center gap-4">
    <!-- Marca: siempre el primer elemento del DOM y lo primero que ve un
         lector de pantalla, por eso el skip-link de Base.astro va antes. -->
    <a
      href="/"
      class="flex shrink-0 items-center gap-2.5 rounded-md"
      aria-label="QBASwing Marketplace, ir al inicio"
    >
      <Logo altura={40} />
      {/* El nombre va con los tres tonos de la bandera, igual que en el pie pero
          con la variante de fondo claro. `whitespace-nowrap` porque el nombre no
          se parte: "QBASwing" en una linea y "Marketplace" en otra se leen como
          dos palabras sueltas. En movil baja el tamano en vez de partirse. */}
      <span
        class="texto-bandera-claro whitespace-nowrap font-headline font-semibold tracking-tight text-title-sm sm:text-title-md"
      >
        QBASwing Marketplace
      </span>
    </a>

    <!-- Navegacion de escritorio. El <nav> lleva aria-label porque hay varios
         bloques de enlaces y un lector de pantalla necesita distinguirlos. -->
    <nav aria-label="Navegacion principal" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {
          NAVEGACION.map((item) => (
            <li>
              <a
                href={item.href}
                class="rounded-full px-4 py-2 text-label-md font-medium text-on-surface-variant transition-colors hover:bg-surface-container-high hover:text-on-surface"
              >
                {item.etiqueta}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex-1"></div>

    <!-- Buscador. Es un <form method="get"> y no un input suelto para que
         funcione sin JavaScript: el navegador lo envia a /productos?q=... -->
    <form
      action="/productos"
      method="get"
      role="search"
      class="hidden lg:block"
    >
      <label for="busqueda" class="sr-only">Buscar productos</label>
      <div class="relative">
        <span
          class="material-symbols-outlined pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-label-md text-on-surface-variant"
          aria-hidden="true"
        >
          {ICONO.buscar}
        </span>
        <input
          type="search"
          id="busqueda"
          name="q"
          placeholder="Buscar productos"
          autocomplete="off"
          class="w-64 rounded-full border border-outline-variant bg-surface-container-low py-2 pl-10 pr-4 text-body-md text-on-surface placeholder:text-on-surface-variant focus:border-primary"
        />
      </div>
    </form>

    <!-- Iconos de accion. Cada uno es un enlace con etiqueta, no un boton sin
         nombre: "carrito" a secas no dice nada en un lector de pantalla.
         El selector de idioma va primero: cambiar el idioma es lo que un
         visitante hace al llegar si no entiende el sitio. -->
    <div class="flex items-center gap-0.5">
      <SelectorIdioma />

      {/*
        Estado de sesion.

        Las DOS opciones estan en el HTML y solo una se muestra. La razon es que el
        sitio es estatico: no hay forma de saber si hay cookie al generar el
        HTML, porque Pages lo sirve sin mirar la peticion. Ademas, decidirlo al
        vuelo con `hidden` en un atributo NO seria seguro: quien quisiera
        ocultarlo es solo question de borrar un atributo en el
        navegador. Por eso lo unico que se oculta es la ENTRADA, y lo que decide
        si se puede ver el panel es siempre el Worker.

        Si el visitante no esta dentro, el icono de cuenta lleva a
        `/iniciar-sesion` y no a `/cuenta`: mandar a alguien que no tiene sesion
        a una pagina que le va a decir "entra" es un rodeo inutil.
      */}
      <a
        href="/iniciar-sesion"
        data-sesion="fuera"
        class="rounded-full p-2 text-on-surface-variant transition-colors hover:bg-surface-container-high hover:text-on-surface"
        aria-label="Entrar en mi cuenta"
      >
        <span class="material-symbols-outlined text-headline-sm" aria-hidden="true">
          {ICONO.cuenta}
        </span>
      </a>

      <a
        href="/cuenta"
        data-sesion="dentro"
        class="hidden rounded-full p-2 text-on-surface-variant transition-colors hover:bg-surface-container-high hover:text-on-surface"
        aria-label="Mi cuenta"
      >
        <span class="material-symbols-outlined text-headline-sm" aria-hidden="true">
          {ICONO.cuenta}
        </span>
      </a>

      <span data-sesion="dentro" class="hidden">
        <BotonCerrarSesion />
      </span>

      <a
        href="/carrito"
        class="rounded-full p-2 text-on-surface-variant transition-colors hover:bg-surface-container-high hover:text-on-surface"
        aria-label="Carrito de compras"
      >
        <span class="material-symbols-outlined text-headline-sm" aria-hidden="true">
          {ICONO.carrito}
        </span>
      </a>
    </div>
  </div>
</header>

<script>
  /*
    Pinta el estado de sesion en la cabecera.

    NO es una comprobacion de seguridad. Este script solo decide si se ve el
    enlace "Entrar" o el boton "Salir", y decide preguntando al Worker, que es el
    unico que puede saberlo. Si alguien lo borra del navegador, lo unico que
    consigue es que no vea un boton: las paginas de panel seguirian sin datos,
    porque la API responde 401 sin cookie.

    Que no se decida en el servidor es consecuencia de que el sitio sea estatico:
    Cloudflare Pages sirve el mismo HTML a todo el mundo, dentro y fuera.
  */
  import { sesionActual } from '../../lib/identidad-cliente'

  function mostrar(dentro: boolean) {
    for (const nodo of document.querySelectorAll<HTMLElement>('[data-sesion]')) {
      const esDentro = nodo.dataset.sesion === 'dentro'
      nodo.classList.toggle('hidden', dentro ? !esDentro : esDentro)
    }
  }

  // Al cargar se pregunta. Sin esto, un visitante que no esta dentro veria un
  // boton "Salir" que no puede hacer nada, o un enlace a su cuenta que acaba
  // en un "entra primero".
  const resultado = await sesionActual()
  mostrar(resultado.ok && resultado.datos.usuario !== null)

  // Si el usuario entra o sale en otra pestana, la cabecera se entera. `storage`
  // es el evento que el navegador lanza entre pestanas del mismo origen; dentro
  // de la misma pestana el script ya se ha enterado por su cuenta.
  window.addEventListener('storage', (evento) => {
    if (evento.key === 'qb:sesion-cambio') {
      void sesionActual().then((r) => mostrar(r.ok && r.datos.usuario !== null))
    }
  })
</script>
