---
/**
 * Las formas de cobro de una tienda, listas para el comprador.
 *
 * ============================================================================
 *  POR QUE ES UN COMPONENTE Y NO DOS TROZOS DE .ASTRO
 * ============================================================================
 * Esto se pinta en la ficha del producto y en la pagina de la tienda. Copiado en
 * los dos sitios, el dia que se anada un tipo de medio habria que acordarse de
 * los dos, y el que se olvide se queda sin boton de pagar sin que nada falle.
 *
 * ============================================================================
 *  DOS FORMAS DE COBRAR, DOS PINTADOS
 * ============================================================================
 *   - Las pasarelas (PayPal, Stripe, Payeer) se cobran con su enlace: se pinta
 *     un boton grande con lo que el vendedor escribio como nombre.
 *   - El resto tiene un dato que se puede teclear o escanear (un numero de
 *     cuenta, un telefono, una cartera), asi que va con su QR y su numero en
 *     texto. Si ademas tiene enlace, el enlace va al lado y no en su lugar: el
 *     numero sigue siendo la via que funciona sin que nadie tenga que confiar en
 *     un boton ajeno.
 *
 * El color de marca lo pone el vendedor en su panel y puede faltar. Si falta no
 * se inventa uno: el sitio usa el color normal.
 */

import type { MedioCobroPublico } from '../lib/api'
import QrCuenta from './QrCuenta.astro'

interface Props {
  medios: MedioCobroPublico[]
}

const { medios } = Astro.props

/** Los tipos que se cobran abriendo un enlace y nada mas. */
const PASARELAS = ['paypal', 'stripe', 'payeer']
---

<div class="space-y-3">
  {
    medios.map((medio) =>
      PASARELAS.includes(medio.tipo) && medio.enlace ? (
        <div
          class="rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-4"
          style={medio.colorMarca ? `border-color:${medio.colorMarca}44` : undefined}
        >
          <p
            class="text-label-sm font-semibold"
            style={medio.colorMarca ? `color:${medio.colorMarca}` : undefined}
          >
            {medio.nombre}
          </p>
          {medio.instrucciones && (
            <p class="mt-1 text-body-sm text-on-surface-variant">{medio.instrucciones}</p>
          )}
          <a
            href={medio.enlace}
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="mt-3 inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2 text-body-md font-semibold text-on-primary transition hover:bg-primary-container"
          >
            Pagar con {medio.nombre}
          </a>
        </div>
      ) : (
        <QrCuenta
          dato={medio.dato ?? ''}
          etiqueta={medio.nombre}
          titular={medio.titular}
          color={medio.colorMarca}
          red={medio.red}
          instrucciones={medio.instrucciones}
        >
          {medio.enlace && (
            <a
              href={medio.enlace}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="mt-3 inline-block rounded-full border border-outline-variant px-4 py-1.5 text-label-md font-semibold text-on-surface transition hover:border-primary hover:text-primary"
            >
              Abrir el enlace de pago
            </a>
          )}
        </QrCuenta>
      ),
    )
  }
</div>
