---
import Base from '../layouts/Base.astro'
---

<Base title="Página no encontrada" sinVolver>
  <section class="container-page flex min-h-[50vh] flex-col items-center justify-center py-20 text-center">
    <p class="font-headline text-title-lg font-semibold text-primary">404</p>
    <h1 class="mt-4 text-title-md font-semibold">Página no encontrada</h1>
    <p class="mt-3 max-w-md text-body-md text-on-surface-variant">
      La página que buscas no existe o cambió de dirección.
    </p>
    <a
      href="/"
      class="mt-8 rounded-full bg-primary px-7 py-3 text-label-lg font-semibold text-on-primary transition hover:bg-primary-container"
    >
      Volver al inicio
    </a>
  </section>
</Base>
