---
/**
 * Vender en el marketplace.
 *
 * ============================================================================
 *  POR QUE ESTA PAGINA NO ES UN FORMULARIO QUE TE HACE VENDEDOR
 * ============================================================================
 * Porque vender aqui no es rellenar un formulario: es pasar por una revision, y una
 * revision no se puede hacer desde una pagina estatica. El sitio es HTML
 * estatico y Pages lo sirve sin mirar quien es, asi que no hay donde tomar una
 * decision de si alguien es apto para vender.
 *
 * Ademas, hacer una tienda al registrarse daria tienda a cualquiera que se
 * apuntara, y con ella capacidad de publicar productos. El analisis de la
 * Regla de Oro y el reparto de dinero asientan en que las tiendas existen; si se
 * crearan solas, no habria nada que analizar.
 *
 * Lo que si hace esta pagina es decir COMO se entra, leer los numeros publicos
 * que de verdad existen y dejar el camino a empezar. Sin inventar plazos, sin
 * prometer comisiones que no estan escritas en ningun sitio.
 *
 * ============================================================================
 *  LO QUE DICE Y LO QUE NO
 * ============================================================================
 * La comision sale de la tabla de tarifas, no de un numero escrito aqui. Si
 * mañana cambia el porcentaje, esta pagina no puede quedar diciendo el viejo.
 *
 * Y si no hay datos, se dice que no los hay. No se rellena con un "5%" de
 * ejemplo, porque un porcentaje inventado en una pagina de ventas es peor que
 * un hueco: la gente se fia del numero.
 */
import Icono from '../components/Icono.astro'
import Miniatura from '../components/Miniatura.astro'
import Base from '../layouts/Base.astro'
import { backendConfigurado, listarPaquetes, API_BASE } from '../lib/api'
import { formatearPrecio } from '../lib/formato'
import { miniaturaDeCategoria, type NombreMiniatura } from '../lib/miniaturas'
import { diccionarioDe } from '../i18n/diccionario'

const t = diccionarioDe(Astro.currentLocale ?? 'es')

let paquetes: Awaited<ReturnType<typeof listarPaquetes>> = []
let error = false

if (backendConfigurado) {
  try {
    paquetes = await listarPaquetes()
  } catch {
    error = true
  }
}

const pasos = [
  {
    numero: '1',
    titulo: t.vender.paso1Titulo,
    miniatura: 'cuenta' as NombreMiniatura,
    texto: t.vender.paso1Texto,
  },
  {
    numero: '2',
    titulo: t.vender.paso2Titulo,
    miniatura: 'servicio' as NombreMiniatura,
    texto: t.vender.paso2Texto,
  },
  {
    numero: '3',
    titulo: t.vender.paso3Titulo,
    miniatura: 'paquete' as NombreMiniatura,
    texto: t.vender.paso3Texto,
  },
  {
    numero: '4',
    titulo: t.vender.paso4Titulo,
    miniatura: 'dinero' as NombreMiniatura,
    texto: t.vender.paso4Texto,
  },
]
---

<Base
  title={t.nav.vender}
  descripcion={t.vender.metaDescripcion}
>
  <section class="w-full py-space-xl">
    <div class="container-page max-w-4xl">
      <h1 class="font-headline text-headline-lg text-on-surface">{t.vender.titulo}</h1>
      <p class="mt-2 text-body-md text-on-surface-variant">
        {t.vender.subtitulo}
      </p>

      <!-- De lo que aqui se vende: digitales y fisicos, que es la division que
           define las tres reglas de comision. Decorativo. -->
      <div class="mt-6 flex flex-wrap items-center gap-3" aria-hidden="true">
        <Miniatura nombre="software" ancho={56} />
        <Miniatura nombre="ropa" ancho={56} />
        <Miniatura nombre="plantilla" ancho={56} />
        <Miniatura nombre="calzado" ancho={56} />
        <Miniatura nombre="curso" ancho={56} />
        <Miniatura nombre="hogar" ancho={56} />
      </div>

      <!-- Los pasos van como una lista de verdad, no como cuatro cajas sueltas.
           Es un proceso con orden, y el orden tiene que poder leerse con un
           lector de pantalla y copiarse como texto. -->
      <ol class="mt-8 space-y-4">
        {
          pasos.map((paso) => (
            <li class="flex items-start gap-4 rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-5">
              <span
                class="flex size-9 shrink-0 items-center justify-center rounded-full bg-primary-container/40 font-headline text-title-md font-semibold text-on-primary-container"
                aria-hidden="true"
              >
                {paso.numero}
              </span>
              <div class="min-w-0">
                <h2 class="font-headline text-title-md font-semibold text-on-surface">
                  {paso.titulo}
                </h2>
                <p class="mt-1 text-body-md text-on-surface-variant">{paso.texto}</p>
              </div>
              <Miniatura nombre={paso.miniatura} ancho={52} clase="ml-auto hidden sm:block" />
            </li>
          ))
        }
      </ol>

      <!-- Paquetes de espacios: salen de la tabla de tarifas. -->
      <h2 class="mt-12 font-headline text-headline-sm font-semibold text-on-surface">
        {t.vender.espaciosTitulo}
      </h2>
      <p class="mt-2 text-body-md text-on-surface-variant">
        {t.vender.espaciosSubtitulo}
      </p>

      {
        error && (
          <div class="mt-4 rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-5 text-body-md text-on-surface-variant">
            <p>{t.vender.espaciosError}</p>
          </div>
        )
      }

      {!error && paquetes.length === 0 && (
        <div class="mt-4 rounded-2xl border border-dashed border-outline-variant bg-surface-container-low p-5 text-body-md text-on-surface-variant">
          <p>{t.vender.espaciosVacio}</p>
        </div>
      )}

      {
        paquetes.length > 0 && (
          <ul class="mt-4 grid gap-4 sm:grid-cols-2">
            {paquetes.map((paquete) => (
              <li class="rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-5">
                <Miniatura nombre={miniaturaDeCategoria(paquete.categoria)} ancho={52} clase="mb-3" />
                <h3 class="font-headline text-title-md font-semibold text-on-surface">
                  {paquete.nombre}
                </h3>

                <p class="mt-1 text-label-md text-on-surface-variant">
                  {paquete.slots} {paquete.slots === 1 ? t.vender.espacio : t.vender.espacios} {t.vender.durante}{' '}
                  {paquete.vigenciaDias} {t.vender.dias}
                </p>

                {/*
                  Los tres precios, no "el precio". Un paquete con precio en las
                  tres monedas no tiene un precio: tiene tres, y esconder dos
                  obligaria al comprador a adivinar. Solo se pinta el precio que
                  el paquete tiene de verdad; los demas se omiten en vez de
                  enseña un cero, porque un 0 se lee como "gratis".
                */}
                <dl class="mt-3 space-y-1">
                  {paquete.precios.CUP > 0 && (
                    <div class="flex items-baseline justify-between gap-3">
                      <dt class="text-body-md text-on-surface-variant">{t.vender.pesos}</dt>
                      <dd class="text-body-md font-semibold text-on-surface">
                        {formatearPrecio(paquete.precios.CUP, 'CUP')}
                      </dd>
                    </div>
                  )}
                  {paquete.precios.USD > 0 && (
                    <div class="flex items-baseline justify-between gap-3">
                      <dt class="text-body-md text-on-surface-variant">{t.vender.dolares}</dt>
                      <dd class="text-body-md font-semibold text-on-surface">
                        {formatearPrecio(paquete.precios.USD, 'USD')}
                      </dd>
                    </div>
                  )}
                  {paquete.precios.EUR > 0 && (
                    <div class="flex items-baseline justify-between gap-3">
                      <dt class="text-body-md text-on-surface-variant">{t.vender.euros}</dt>
                      <dd class="text-body-md font-semibold text-on-surface">
                        {formatearPrecio(paquete.precios.EUR, 'EUR')}
                      </dd>
                    </div>
                  )}
                </dl>

                {paquete.caracteristicas.length > 0 && (
                  <ul class="mt-3 space-y-1 text-label-md text-on-surface-variant">
                    {paquete.caracteristicas.map((caracteristica) => (
                      <li class="flex items-start gap-1.5">
                        <Icono nombre="check" class="text-label-md" />
                        {caracteristica}
                      </li>
                    ))}
                  </ul>
                )}

                {/*
                  `precioConfigurable` en cero significa que el Owner todavia no
                  le ha puesto precio a esta categoria. Se dice con palabras, no
                  con un "0", porque el cero se lee como gratis y aqui no lo es.
                */}
                {paquete.precios.CUP === 0 &&
                  paquete.precios.USD === 0 &&
                  paquete.precios.EUR === 0 && (
                    <p class="mt-3 text-label-md text-outline">
                      {t.vender.sinPrecio}
                    </p>
                  )}
              </li>
            ))}
          </ul>
        )
      }

      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href="/registro"
          class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-body-md font-semibold text-on-primary transition hover:bg-primary-container"
        >
          <Icono nombre="person_add" class="text-label-md" />
          {t.cuenta.crear}
        </a>
        <a
          href="/terminos"
          class="inline-flex items-center gap-2 rounded-full border border-outline-variant px-6 py-3 text-body-md font-semibold text-on-surface transition hover:border-primary"
        >
          {t.vender.leerTerminos}
        </a>
      </div>
    </div>
  </section>

  <!--
    Archivo maestro de un producto digital. Esta seccion NO se usa desde esta
    pagina a secas: vive aqui porque el vendedor llega desde la edicion de un
    producto, con `?producto=<id>` en la URL. Sin ese id no hay a que colgar el
    archivo, y la seccion lo dice en vez de fallar en silencio.
  -->
  <section class="container-page max-w-4xl pb-space-xl">
    <h2 class="font-headline text-title-lg font-semibold text-on-surface">
      Archivo maestro (productos digitales)
    </h2>
    <p class="mt-2 text-body-md text-on-surface-variant">
      Se sube una sola vez. Cada compra descarga ese mismo original por streaming
      autorizado, solo para quien compró y su pago está verificado.
    </p>

    <div class="mt-5 flex flex-col gap-4 sm:flex-row sm:items-end">
      <div>
        <label for="maestro-almacen" class="block text-label-md font-medium text-on-surface">
          Dónde se guarda
        </label>
        <select
          id="maestro-almacen"
          class="mt-1 rounded-lg border border-outline-variant bg-surface-container-lowest px-3 py-2 text-body-md text-on-surface"
        >
          <option value="kv">KV · hasta 25 MB (recomendado)</option>
          <option value="drive">Google Drive</option>
          <option value="pixeldrain">Pixeldrain</option>
          <option value="gofile">GoFile.io</option>
          <option value="fraccionado" disabled>Fraccionado · próximamente</option>
        </select>
      </div>

      <div class="flex-1">
        <label for="maestro-archivo" class="block text-label-md font-medium text-on-surface">
          Archivo (.zip .rar .7z .pdf .tar.gz)
        </label>
        <input
          id="maestro-archivo"
          type="file"
          accept=".zip,.rar,.7z,.pdf,.tar.gz,application/zip,application/vnd.rar,application/x-7z-compressed,application/pdf,application/gzip"
          class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-lowest px-3 py-2 text-body-md text-on-surface"
        />
      </div>

      <button
        id="maestro-subir"
        type="button"
        class="rounded-full bg-primary px-5 py-2.5 text-body-md font-semibold text-on-primary transition hover:bg-primary-container"
      >
        Subir archivo maestro
      </button>
    </div>

    <p id="maestro-estado" class="mt-3 text-body-sm text-on-surface-variant" role="status"></p>
    <input type="hidden" name="tiene_maestro" value="0" />
  </section>

  <script>
    // El id del producto viaja en la URL (`?producto=12`). Se lee aqui y no se
    // escribe en el HTML para no interpolar un valor que viene de la query en
    // una plantilla: una inyeccion seria un script ejecutando como este.
    const pid = new URLSearchParams(location.search).get('producto')

    const btn = document.getElementById('maestro-subir')
    const archivoEl = document.getElementById('maestro-archivo') as HTMLInputElement | null
    const almacenEl = document.getElementById('maestro-almacen') as HTMLSelectElement | null
    const estado = document.getElementById('maestro-estado')
    const oculto = document.querySelector<HTMLInputElement>('[name="tiene_maestro"]')

    const ENDPOINTS: Record<string, string> = {
      kv: 'kv',
      drive: 'drive',
      pixeldrain: 'pixeldrain',
      gofile: 'gofile',
    }

    /*
     * Que almacenes se pueden usar AHORA MISMO.
     *
     * El sitio es estatico y el Worker vive en otro host: este desplegable se
     * pintaba con las cuatro opciones siempre, y elegir una sin configurar
     * acababa en un fallo del servidor despues de rellenar todo. Se pregunta a
     * `/api/salud`, que informa de si cada integracion tiene su secreto.
     *
     * Si la consulta no responde, NO se deshabilita nada: ofrecer un almacen de
     * mas es menos malo que esconder KV por un fallo de red.
     *
     * KV no aparece en la respuesta porque vive en el propio Worker: no depende
     * de ninguna integracion y por eso se salta.
     */
    async function marcarAlmacenes(): Promise<void> {
      if (!almacenEl) return

      try {
        const r = await fetch(`${API_BASE}/api/salud`, {
          headers: { Accept: 'application/json' },
        })
        if (!r.ok) return

        const datos = (await r.json()) as {
          integraciones?: Record<string, { configurado?: boolean }>
        }
        const integraciones = datos.integraciones ?? {}

        for (const opcion of Array.from(almacenEl.options)) {
          const valor = opcion.value
          if (valor === 'kv' || valor === 'fraccionado') continue
          // Sin noticia de ese almacen, se deja como estaba.
          if (integraciones[valor]?.configurado !== false) continue

          opcion.disabled = true
          opcion.textContent = `${opcion.textContent} · no disponible`
          if (almacenEl.value === valor) almacenEl.value = 'kv'
        }
      } catch {
        // Sin diagnostico no se toca el desplegable.
      }
    }

    void marcarAlmacenes()

    async function subirMaestro(): Promise<void> {
      if (!estado || !archivoEl || !almacenEl) return

      if (!pid) {
        estado.textContent = 'Abre esta sección desde la edición de un producto.'
        return
      }

      const archivo = archivoEl.files?.[0]
      if (!archivo) {
        estado.textContent = 'Selecciona un archivo.'
        return
      }

      // El tope de KV también lo comprueba el Worker, pero avisarlo aquí
      // evita subir 30 MB para que el servidor diga que no.
      const MB = 1024 * 1024
      if (almacenEl.value === 'kv' && archivo.size > 25 * MB) {
        estado.textContent = `KV admite hasta 25 MB y este archivo pesa ${(archivo.size / MB).toFixed(1)} MB. Elige otro almacén en la lista.`
        return
      }

      if (archivo.size > 100 * MB) {
        const seguir = window.confirm(
          `Este archivo pesa ${(archivo.size / MB).toFixed(1)} MB. Una subida así puede tardar bastante, y si la conexión se corta hay que empezar de nuevo. ¿Subirlo igualmente?`,
        )
        if (!seguir) {
          estado.textContent = 'Subida cancelada.'
          return
        }
      }

      const ruta = ENDPOINTS[almacenEl.value]
      if (!ruta) {
        estado.textContent = 'Esa ruta todavía no está disponible.'
        return
      }

      const cuerpo = new FormData()
      cuerpo.append('archivo', archivo)

      if (btn instanceof HTMLButtonElement) btn.disabled = true
      estado.textContent = 'Subiendo…'

      try {
        const respuesta = await fetch(
          `/api/panel/productos/${pid}/maestro/${ruta}`,
          { method: 'POST', body: cuerpo, credentials: 'include' },
        )
        const datos = (await respuesta.json()) as { ok?: boolean; mensaje?: string }

        if (datos.ok) {
          estado.textContent = 'Archivo maestro subido.'
          if (oculto) oculto.value = '1'
        } else {
          estado.textContent = datos.mensaje || 'No se pudo subir el archivo.'
        }
      } catch {
        estado.textContent = 'Error de red.'
      } finally {
        if (btn instanceof HTMLButtonElement) btn.disabled = false
      }
    }

    btn?.addEventListener('click', () => {
      void subirMaestro()
    })
  </script>
</Base>
