---
/**
 * Vender en el marketplace.
 *
 * ============================================================================
 *  POR QUE ESTA PAGINA NO ES UN FORMULARIO QUE TE HACE VENDEDOR
 * ============================================================================
 * Porque vender aqui no es rellenar un formulario: es pasar por una revision, y una
 * revision no se puede hacer desde una pagina estatica. El sitio es HTML
 * estatico y Pages lo sirve sin mirar quien es, asi que no hay donde tomar una
 * decision de si alguien es apto para vender.
 *
 * Ademas, hacer una tienda al registrarse daria tienda a cualquiera que se
 * apuntara, y con ella capacidad de publicar productos. El analisis de la
 * Regla de Oro y el reparto de dinero asientan en que las tiendas existen; si se
 * crearan solas, no habria nada que analizar.
 *
 * Lo que si hace esta pagina es decir COMO se entra, leer los numeros publicos
 * que de verdad existen y dejar el camino a empezar. Sin inventar plazos, sin
 * prometer comisiones que no estan escritas en ningun sitio.
 *
 * ============================================================================
 *  LO QUE DICE Y LO QUE NO
 * ============================================================================
 * La comision sale de la tabla de tarifas, no de un numero escrito aqui. Si
 * mañana cambia el porcentaje, esta pagina no puede quedar diciendo el viejo.
 *
 * Y si no hay datos, se dice que no los hay. No se rellena con un "5%" de
 * ejemplo, porque un porcentaje inventado en una pagina de ventas es peor que
 * un hueco: la gente se fia del numero.
 */
import Base from '../layouts/Base.astro'
import { backendConfigurado, listarPaquetes } from '../lib/api'
import { formatearPrecio } from '../lib/formato'

let paquetes: Awaited<ReturnType<typeof listarPaquetes>> = []
let error = false

if (backendConfigurado) {
  try {
    paquetes = await listarPaquetes()
  } catch {
    error = true
  }
}

const pasos = [
  {
    numero: '1',
    titulo: 'Crea tu cuenta',
    texto:
      'Correo y contrasena. Con eso ya tienes cuenta y un espacio propio para empezar a preparar tu tienda.',
  },
  {
    numero: '2',
    titulo: 'Cuenta con el Owner',
    texto:
      'Se revisa quien eres y que vendes. Es una conversacion, no un formulario automatico. Es el paso unico que no se puede automatizar.',
  },
  {
    numero: '3',
    titulo: 'Publicas tus productos',
    texto:
      'Digitales, fisicos o servicios. Tu tienda tiene su propia pagina y sus ventas se registran solas.',
  },
  {
    numero: '4',
    titulo: 'Te llega el dinero',
    texto:
      'Cuando el comprador recibe lo que compro. El pago pasa por la plataforma y la parte del vendedor se entrega despues de la entrega verificada.',
  },
]
---

<Base
  title="Vender"
  descripcion="Como vender tus productos en QBASwing Marketplace."
>
  <section class="w-full py-space-xl">
    <div class="container-page max-w-4xl">
      <h1 class="font-headline text-headline-lg text-on-surface">Vender aqui</h1>
      <p class="mt-2 text-body-md text-on-surface-variant">
        Que se necesita, en el orden en que se necesita.
      </p>

      <!-- Los pasos van como una lista de verdad, no como cuatro cajas sueltas.
           Es un proceso con orden, y el orden tiene que poder leerse con un
           lector de pantalla y copiarse como texto. -->
      <ol class="mt-8 space-y-4">
        {
          pasos.map((paso) => (
            <li class="flex items-start gap-4 rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-5">
              <span
                class="flex size-9 shrink-0 items-center justify-center rounded-full bg-primary-container/40 font-headline text-title-md font-semibold text-on-primary-container"
                aria-hidden="true"
              >
                {paso.numero}
              </span>
              <div class="min-w-0">
                <h2 class="font-headline text-title-md font-semibold text-on-surface">
                  {paso.titulo}
                </h2>
                <p class="mt-1 text-body-md text-on-surface-variant">{paso.texto}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <!-- Paquetes de espacios: salen de la tabla de tarifas. -->
      <h2 class="mt-12 font-headline text-headline-sm font-semibold text-on-surface">
        Espacios para tu tienda
      </h2>
      <p class="mt-2 text-body-md text-on-surface-variant">
        Cada paquete mete tu tienda en mas sitios del marketplace.
      </p>

      {
        error && (
          <div class="mt-4 rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-5 text-body-md text-on-surface-variant">
            <p>No se pudieron cargar los precios de los paquetes.</p>
          </div>
        )
      }

      {!error && paquetes.length === 0 && (
        <div class="mt-4 rounded-2xl border border-dashed border-outline-variant bg-surface-container-low p-5 text-body-md text-on-surface-variant">
          <p>
            Todavia no hay paquetes de espacios a la venta. Cuando los haya, estan
            aqui con su precio.
          </p>
        </div>
      )}

      {
        paquetes.length > 0 && (
          <ul class="mt-4 grid gap-4 sm:grid-cols-2">
            {paquetes.map((paquete) => (
              <li class="rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-5">
                <h3 class="font-headline text-title-md font-semibold text-on-surface">
                  {paquete.nombre}
                </h3>

                <p class="mt-1 text-label-md text-on-surface-variant">
                  {paquete.slots} {paquete.slots === 1 ? 'espacio' : 'espacios'} durante{' '}
                  {paquete.vigenciaDias} dias
                </p>

                {/*
                  Los tres precios, no "el precio". Un paquete con precio en las
                  tres monedas no tiene un precio: tiene tres, y esconder dos
                  obligaria al comprador a adivinar. Solo se pinta el precio que
                  el paquete tiene de verdad; los demas se omiten en vez de
                  enseña un cero, porque un 0 se lee como "gratis".
                */}
                <dl class="mt-3 space-y-1">
                  {paquete.precios.CUP > 0 && (
                    <div class="flex items-baseline justify-between gap-3">
                      <dt class="text-body-md text-on-surface-variant">Pesos</dt>
                      <dd class="text-body-md font-semibold text-on-surface">
                        {formatearPrecio(paquete.precios.CUP, 'CUP')}
                      </dd>
                    </div>
                  )}
                  {paquete.precios.USD > 0 && (
                    <div class="flex items-baseline justify-between gap-3">
                      <dt class="text-body-md text-on-surface-variant">Dolares</dt>
                      <dd class="text-body-md font-semibold text-on-surface">
                        {formatearPrecio(paquete.precios.USD, 'USD')}
                      </dd>
                    </div>
                  )}
                  {paquete.precios.EUR > 0 && (
                    <div class="flex items-baseline justify-between gap-3">
                      <dt class="text-body-md text-on-surface-variant">Euros</dt>
                      <dd class="text-body-md font-semibold text-on-surface">
                        {formatearPrecio(paquete.precios.EUR, 'EUR')}
                      </dd>
                    </div>
                  )}
                </dl>

                {paquete.caracteristicas.length > 0 && (
                  <ul class="mt-3 space-y-1 text-label-md text-on-surface-variant">
                    {paquete.caracteristicas.map((caracteristica) => (
                      <li class="flex items-start gap-1.5">
                        <span class="material-symbols-outlined text-label-md" aria-hidden="true">
                          check
                        </span>
                        {caracteristica}
                      </li>
                    ))}
                  </ul>
                )}

                {/*
                  `precioConfigurable` en cero significa que el Owner todavia no
                  le ha puesto precio a esta categoria. Se dice con palabras, no
                  con un "0", porque el cero se lee como gratis y aqui no lo es.
                */}
                {paquete.precios.CUP === 0 &&
                  paquete.precios.USD === 0 &&
                  paquete.precios.EUR === 0 && (
                    <p class="mt-3 text-label-md text-outline">
                      Todavia no tiene precio asignado.
                    </p>
                  )}
              </li>
            ))}
          </ul>
        )
      }

      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href="/registro"
          class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-body-md font-semibold text-on-primary transition hover:bg-primary-container"
        >
          <span class="material-symbols-outlined text-label-md" aria-hidden="true">
            person_add
          </span>
          Crear mi cuenta
        </a>
        <a
          href="/terminos"
          class="inline-flex items-center gap-2 rounded-full border border-outline-variant px-6 py-3 text-body-md font-semibold text-on-surface transition hover:border-primary"
        >
          Leer los terminos
        </a>
      </div>
    </div>
  </section>
</Base>