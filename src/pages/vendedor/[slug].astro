---
/**
 * Vendedor individual.
 */
import Miniatura from '../../components/Miniatura.astro'
import Base from '../../layouts/Base.astro'
import { formatearPrecio, recortar } from '../../lib/formato'
import { miniaturaDeCategoria } from '../../lib/miniaturas'

import { IDIOMAS } from '../../i18n/config'
import { listarVendedores, obtenerVendedor } from '../../lib/api'
import { diccionarioDe } from '../../i18n/diccionario'

const t = diccionarioDe(Astro.currentLocale ?? 'es')

/**
 * Imports estaticos, por la misma razon que en la ficha de producto: Astro
 * extrae `getStaticPaths` a su propio ambito y un `const` de un `await import()`
 * no esta visible ahi dentro. El detalle esta en `producto/[slug].astro`.
 */

/**
 * ============================================================================
 *  POR QUE NO PUEDE DEVOLVER `[]`
 * ============================================================================
 * Antes devolvia `[]`. Aqui no es SSR: es HTML estatico en Cloudflare Pages, sin
 * funciones. Devolver `[]` no deja las rutas "para cuando haga falta": no deja
 * ninguna. El build se terminaba sin un aviso, el despliegue salia bien, y
 * `/vendedor/<cualquier-cosa>` daba 404 en produccion.
 *
 * Es el mismo fallo que el de la ficha de producto, y por eso la explicacion
 * esta ahi y aqui solo se remite a ella.
 *
 * ============================================================================
 *  QUE SE PIDE Y QUE SE CORTE
 * ============================================================================
 * El listado troceado, en bucle, y se corta con `paginas`, que es el numero que
 * da la propia API. Pedir solo la primera pagina deja al resto en 404 sin un solo
 * error en ninguna parte.
 */
export async function getStaticPaths() {
  let slugs: string[] = []

  try {
    const POR_PAGINA = 100
    for (let pagina = 1; ; pagina += 1) {
      const r = await listarVendedores({ pagina, porPagina: POR_PAGINA })
      slugs.push(...r.items.map((v) => v.slug).filter(Boolean))
      if (r.items.length === 0 || pagina >= r.paginas) break
      if (pagina > 50) break
    }
  } catch (e) {
    console.warn(
      `[getStaticPaths] No se pudo pedir el listado de vendedores, no se genera ninguna ficha. ` +
        `El sitio se publicara sin fichas de vendedor. Motivo: ${(e as Error)?.message ?? e}`,
    )
    return []
  }

  console.log(`[getStaticPaths] vendedores pedidos: ${slugs.length}`)

  return slugs.map((slug) => ({ params: { slug }, locales: [...IDIOMAS] }))
}

const { slug } = Astro.params
let vendedor: Awaited<ReturnType<typeof obtenerVendedor>> | null = null
let error = false
let mensaje = ''

try {
  if (slug) {
    vendedor = await obtenerVendedor(slug)
  } else {
    error = true
    mensaje = t.vendedor.faltaIdentificador
  }
} catch (e: any) {
  error = true
  mensaje = e?.message || t.vendedor.cargaFallida
}

const titulo = vendedor ? vendedor.nombreComercial || vendedor.nombre : t.producto.vendedor
---

<Base title={titulo}>
  <section class="w-full py-space-xl">
    <div class="container-page max-w-5xl">
      {error && (
        <div class="rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-8 text-center">
          <h1 class="font-headline text-headline-sm text-on-surface">{t.vendedor.errorTitulo}</h1>
          <p class="mt-2 text-body-md text-on-surface-variant">{mensaje}</p>
          <a href="/productos" class="mt-4 inline-flex items-center gap-2 rounded-full border border-outline-variant px-5 py-2 text-body-md font-semibold text-primary transition hover:border-primary">
            {t.ficha.volverCatalogo}
          </a>
        </div>
      )}

      {!error && !vendedor && (
        <div class="rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-8 text-center">
          <h1 class="font-headline text-headline-sm text-on-surface">{t.vendedor.noEncontrado}</h1>
          <p class="mt-2 text-body-md text-on-surface-variant">{t.vendedor.noEncontradoTexto}</p>
          <a href="/productos" class="mt-4 inline-flex items-center gap-2 rounded-full border border-outline-variant px-5 py-2 text-body-md font-semibold text-primary transition hover:border-primary">
            {t.ficha.volverCatalogo}
          </a>
        </div>
      )}

      {vendedor && (
        <>
          <header class="rounded-3xl border border-outline-variant/60 bg-surface-container-lowest p-8 shadow-e1">
            <div class="flex flex-wrap items-center justify-between gap-6">
              <div>
                <h1 class="font-headline text-headline-md text-on-surface">
                  {vendedor.nombreComercial || vendedor.nombre}
                </h1>
                <p class="mt-2 max-w-2xl text-body-md text-on-surface-variant whitespace-pre-line">
                  {vendedor.descripcion || t.vendedor.sinDescripcion}
                </p>
                <div class="mt-4 flex flex-wrap gap-3 text-label-sm text-on-surface-variant">
                  <span class="rounded-full bg-surface-container-high px-3 py-1">
                    {vendedor.productosPublicados} {vendedor.productosPublicados === 1 ? t.vendedor.producto : t.vendedor.productos}
                  </span>
                  {vendedor.ubicacion && <span class="rounded-full bg-surface-container-high px-3 py-1">{vendedor.ubicacion}</span>}
                  {vendedor.verificado && <span class="rounded-full bg-primary/10 px-3 py-1 text-primary">{t.vendedor.verificado}</span>}
                </div>
              </div>
            </div>
          </header>

          <section class="mt-8">
            <h2 class="font-headline text-title-lg font-semibold text-on-surface">{t.perfil.misProductos}</h2>
            {vendedor.productos.length === 0 ? (
              <p class="mt-2 text-body-md text-on-surface-variant">{t.vendedor.sinProductos}</p>
            ) : (
              <div class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
                {vendedor.productos.map((p) => (
                  <a href={`/producto/${p.slug}`} class="group flex flex-col overflow-hidden rounded-2xl border border-outline-variant/60 bg-surface-container-lowest shadow-e1 transition hover:shadow-e2">
                    <div class="aspect-[4/3] w-full bg-surface-container-high">
                      {p.imagen ? (
                        <img src={p.imagen} alt={p.titulo} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                      ) : (
                        <div class="flex h-full w-full items-center justify-center">
                          <Miniatura nombre={miniaturaDeCategoria(p.categoria)} ancho={84} />
                        </div>
                      )}
                    </div>
                    <div class="flex flex-1 flex-col p-4">
                      <h3 class="font-headline text-title-md font-semibold text-on-surface">{recortar(p.titulo, 10)}</h3>
                      <p class="mt-4 font-headline text-title-lg font-semibold text-primary">{formatearPrecio(p.precio, p.moneda)}</p>
                    </div>
                  </a>
                ))}
              </div>
            )}
          </section>
        </>
      )}
    </div>
  </section>
</Base>
