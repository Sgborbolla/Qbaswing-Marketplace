---
/**
 * Términos y condiciones.
 *
 * Lo que hay aquí es lo que el sistema hace, no lo que promete en general.
 * No incluye clausulas sobre garantia del 100%, devoluciones generales ni
 * custodia de fondos, porque ninguna de esas cosas esta implementada.
 */
import Base from '../layouts/Base.astro'
import Miniatura from '../components/Miniatura.astro'
import { diccionarioDe } from '../i18n/diccionario'

const t = diccionarioDe(Astro.currentLocale ?? 'es')
---

<Base title={t.terminos.titulo}>
  <section class="w-full py-space-xl">
    <div class="container-page max-w-4xl">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h1 class="font-headline text-headline-lg text-on-surface">
            {t.terminos.titulo}
          </h1>
          <p class="mt-2 text-body-sm text-on-surface-variant">
            {t.terminos.ultimaActualizacion} {new Date().toLocaleDateString('es-CU')}
          </p>
        </div>
        <Miniatura nombre="codigo" ancho={64} />
      </div>

      <div class="mt-8 space-y-8 text-body-md text-on-surface-variant">
        <section>
          <h2 class="font-headline text-title-lg font-semibold text-on-surface">
            {t.terminos.aceptacion}
          </h2>
          <p class="mt-2">
            {t.terminos.aceptacionTexto}
          </p>
        </section>

        <section>
          <h2 class="font-headline text-title-lg font-semibold text-on-surface">
            {t.terminos.reglasComision}
          </h2>
          <p class="mt-2">
            {t.terminos.reglasComisionTexto}
          </p>
        </section>

        <section>
          <h2 class="font-headline text-title-lg font-semibold text-on-surface">
            {t.terminos.comprasDescargas}
          </h2>
          <p class="mt-2">
            {t.terminos.comprasDescargasTexto}
          </p>
        </section>

        <section>
          <h2 class="font-headline text-title-lg font-semibold text-on-surface">
            {t.terminos.publicacionModeracion}
          </h2>
          <p class="mt-2">
            {t.terminos.publicacionModeracionTexto}
          </p>
        </section>

        <section>
          <h2 class="font-headline text-title-lg font-semibold text-on-surface">
            {t.terminos.pagos}
          </h2>
          <p class="mt-2">
            {t.terminos.pagosTexto}
          </p>
        </section>

        <section>
          <h2 class="font-headline text-title-lg font-semibold text-on-surface">
            {t.terminos.responsabilidad}
          </h2>
          <p class="mt-2">
            {t.terminos.responsabilidadTexto}
          </p>
        </section>
      </div>
    </div>
  </section>
</Base>
