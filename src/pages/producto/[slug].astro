---
/**
 * Producto individual.
 *
 * Página dinámica: `/producto/[slug].astro`. Lee desde la API por slug.
 * Estados vacíos reales si no existe o falla la carga.
 */
import Miniatura from '../../components/Miniatura.astro'
import Base from '../../layouts/Base.astro'
import QrCuenta from '../../components/QrCuenta.astro'
import { formatearFecha, formatearPrecio } from '../../lib/formato'
import { miniaturaDeCategoria } from '../../lib/miniaturas'

import { IDIOMAS } from '../../i18n/config'
import { listarProductos, obtenerMediosPago, obtenerProducto } from '../../lib/api'
import { diccionarioDe } from '../../i18n/diccionario'

export async function getStaticPaths() {
  let slugs: string[] = []

  try {
    const POR_PAGINA = 100
    for (let pagina = 1; ; pagina += 1) {
      const r = await listarProductos({ pagina, porPagina: POR_PAGINA })
      slugs.push(...r.items.map((p) => p.slug).filter(Boolean))
      if (r.items.length === 0 || pagina >= r.paginas) break
      if (pagina > 50) break
    }
  } catch (e) {
    console.warn(
      `[getStaticPaths] No se pudo pedir el catalogo a la API, no se genera ninguna ficha de producto. ` +
        `El sitio se publicara sin fichas. Motivo: ${(e as Error)?.message ?? e}`,
    )
    return []
  }

  return slugs.map((slug) => ({ params: { slug }, locales: [...IDIOMAS] }))
}

const { slug } = Astro.params
const t = diccionarioDe(Astro.currentLocale)
let producto: Awaited<ReturnType<typeof obtenerProducto>> | null = null
let error = false
let mensaje = ''

try {
  if (slug) {
    producto = await obtenerProducto(slug)
  } else {
    error = true
    mensaje = t.ficha.faltaIdentificador
  }
} catch (e: any) {
  error = true
  mensaje = e?.message || t.ficha.cargaFallida
}

const titulo = producto ? producto.titulo : error ? t.ficha.errorCarga : t.ficha.noEncontrado

const medios = producto ? await obtenerMediosPago() : []
const mediosListos = medios.filter((m) => (m.dato ?? '').trim() !== '')

// La galería: nombre propio para lo que ya viene, y la miniatura de la
// categoría cuando no hay ninguna imagen. Un producto sin fotos es válido y
// tiene que poder venderse igual.
const galeria = producto?.imagenes ?? []
const portada = galeria[0]?.url ?? producto?.imagen ?? null

// Especificaciones según el tipo, ya en filas «etiqueta: valor». Se saltan las
// que vienen vacías: una tabla con «Licencia: —» parece un error del sitio.
type Fila = { etiqueta: string; valor: string }
const especificaciones: Fila[] = []
if (producto) {
  const d = producto.detallesDigitales
  if (d) {
    if (d.stack) especificaciones.push({ etiqueta: 'Tecnologías', valor: d.stack.replace(/^\[|\]$/g, '').replace(/"/g, '') })
    if (d.licencia) especificaciones.push({ etiqueta: 'Licencia', valor: d.licencia })
    if (d.version) especificaciones.push({ etiqueta: 'Versión', valor: d.version })
    if (d.ultimaActualizacion) especificaciones.push({ etiqueta: 'Última versión', valor: d.ultimaActualizacion })
    if (d.formatoEntrega) especificaciones.push({ etiqueta: 'Entrega', valor: d.formatoEntrega })
  }
  const fi = producto.detallesFisicos
  if (fi) {
    if (fi.stock !== null) especificaciones.push({ etiqueta: 'Existencias', valor: String(fi.stock) })
    if (fi.envio) especificaciones.push({ etiqueta: 'Envío', valor: fi.envio })
    if (fi.processingTime) especificaciones.push({ etiqueta: 'Preparación', valor: fi.processingTime })
    if (fi.pesoKg) especificaciones.push({ etiqueta: 'Peso', valor: `${fi.pesoKg} kg` })
  }
  const s = producto.detallesServicio
  if (s) {
    if (s.modalidad) especificaciones.push({ etiqueta: 'Modalidad', valor: modalidadTexto(s.modalidad) })
    if (s.duracionEstimada) especificaciones.push({ etiqueta: 'Duración', valor: s.duracionEstimada })
    if (s.incluye) especificaciones.push({ etiqueta: 'Incluye', valor: s.incluye.replace(/^\[|\]$/g, '').replace(/"/g, '') })
  }
}

function modalidadTexto(v: string): string {
  if (v === 'presencial') return 'Presencial'
  if (v === 'remoto') return 'En línea'
  return 'Mixta'
}

// Las redes con su nombre legible. Un enlace con el nombre en crudo
// («instagram») se lee peor que «Instagram».
const NOMBRE_RED: Record<string, string> = {
  facebook: 'Facebook',
  instagram: 'Instagram',
  tiktok: 'TikTok',
  x: 'X',
  youtube: 'YouTube',
  telegram: 'Telegram',
  whatsapp: 'WhatsApp',
  linkedin: 'LinkedIn',
  github: 'GitHub',
  web: 'Sitio web',
}

const contacto = producto?.contacto ?? null
const redes = producto?.redes ?? []
const sinExistencias = producto?.tipo === 'fisico' && (producto.detallesFisicos?.stock ?? 0) <= 0
---

<Base title={titulo}>
  <section class="w-full py-space-xl">
    <div class="container-page max-w-6xl">
      {error && (
        <div class="rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-8 text-center">
          <h1 class="font-headline text-headline-sm text-on-surface">{t.ficha.errorTitulo}</h1>
          <p class="mt-2 text-body-md text-on-surface-variant">{mensaje}</p>
          <a href="/productos" class="mt-4 inline-flex items-center gap-2 rounded-full border border-outline-variant px-5 py-2 text-body-md font-semibold text-primary transition hover:border-primary">
            {t.ficha.volverCatalogo}
          </a>
        </div>
      )}

      {!error && !producto && (
        <div class="rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-8 text-center">
          <h1 class="font-headline text-headline-sm text-on-surface">{t.ficha.noEncontrado}</h1>
          <p class="mt-2 text-body-md text-on-surface-variant">{t.ficha.noEncontradoTexto}</p>
          <a href="/productos" class="mt-4 inline-flex items-center gap-2 rounded-full border border-outline-variant px-5 py-2 text-body-md font-semibold text-primary transition hover:border-primary">
            {t.ficha.volverCatalogo}
          </a>
        </div>
      )}

      {producto && (
        <article class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_380px]">
          {/* ---------- Galería + descripción ---------- */}
          <div class="min-w-0">
            <nav class="mb-4 flex flex-wrap items-center gap-2 text-label-sm text-on-surface-variant">
              <a href="/productos" class="hover:text-primary">Catálogo</a>
              <span>/</span>
              <span>{producto.categoria}</span>
            </nav>

            <div class="overflow-hidden rounded-2xl border border-outline-variant/60 bg-surface-container-lowest shadow-e1">
              <div class="aspect-square w-full bg-surface-container-high">
                {portada ? (
                  <img
                    id="imagen-principal"
                    src={portada}
                    alt={producto.titulo}
                    class="h-full w-full object-cover"
                  />
                ) : (
                  <div class="flex h-full w-full items-center justify-center">
                    <Miniatura nombre={miniaturaDeCategoria(producto.categoria)} ancho={160} prioridad />
                  </div>
                )}
              </div>
            </div>

            {galeria.length > 1 && (
              <div class="mt-3 flex gap-2 overflow-x-auto pb-1">
                {galeria.map((img, i) => (
                  <button
                    type="button"
                    class="mini h-20 w-20 shrink-0 overflow-hidden rounded-xl border-2 border-outline-variant/60 transition"
                    data-src={img.url}
                    aria-label={`Imagen ${i + 1}`}
                  >
                    <img src={img.url} alt={img.alt ?? producto!.titulo} class="h-full w-full object-cover" />
                  </button>
                ))}
              </div>
            )}

            <section class="mt-8">
              <h2 class="font-headline text-headline-sm text-on-surface">Descripción</h2>
              <p class="mt-3 whitespace-pre-line text-body-lg text-on-surface-variant">
                {producto.descripcionLarga || producto.descripcion}
              </p>
            </section>

            {especificaciones.length > 0 && (
              <section class="mt-8">
                <h2 class="font-headline text-headline-sm text-on-surface">Detalles</h2>
                <dl class="mt-3 overflow-hidden rounded-2xl border border-outline-variant/60">
                  {especificaciones.map((f, i) => (
                    <div class:list={["flex items-start gap-4 px-4 py-3 text-body-md", i % 2 === 1 && "bg-surface-container-low"]}>
                      <dt class="w-40 shrink-0 font-semibold text-on-surface">{f.etiqueta}</dt>
                      <dd class="text-on-surface-variant">{f.valor}</dd>
                    </div>
                  ))}
                </dl>
              </section>
            )}

            {(contacto || redes.length > 0) && (
              <section class="mt-8 rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-5">
                <h2 class="font-headline text-headline-sm text-on-surface">Contacto de la tienda</h2>
                <div class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-body-md text-on-surface-variant">
                  {contacto?.telefono && <p>Teléfono: <a class="text-primary hover:underline" href={`tel:${contacto.telefono}`}>{contacto.telefono}</a></p>}
                  {contacto?.whatsapp && <p>WhatsApp: <a class="text-primary hover:underline" href={`https://wa.me/${contacto.whatsapp.replace(/[^0-9]/g, '')}`} target="_blank" rel="noopener noreferrer">{contacto.whatsapp}</a></p>}
                  {contacto?.correo && <p>Correo: <a class="text-primary hover:underline" href={`mailto:${contacto.correo}`}>{contacto.correo}</a></p>}
                  {contacto?.direccion && <p>Dirección: {contacto.direccion}</p>}
                  {contacto?.sitioWeb && <p>Sitio: <a class="text-primary hover:underline" href={contacto.sitioWeb} target="_blank" rel="noopener noreferrer">{contacto.sitioWeb}</a></p>}
                </div>
                {redes.length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-2">
                    {redes.map((r) => (
                      <a
                        href={r.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="rounded-full border border-outline-variant px-3 py-1 text-label-md text-on-surface transition hover:border-primary hover:text-primary"
                      >
                        {NOMBRE_RED[r.red] ?? r.red}
                      </a>
                    ))}
                  </div>
                )}
              </section>
            )}
          </div>

          {/* ---------- Caja de compra ---------- */}
          <aside class="lg:sticky lg:top-24 lg:self-start">
            <p class="text-label-md text-primary">{producto.vendedorNombre}{producto.vendedorVerificado && ' ✓'}</p>
            <h1 class="mt-2 font-headline text-headline-md text-on-surface">{producto.titulo}</h1>

            <div class="mt-4 flex flex-col">
              {producto.precioAnterior && producto.precioAnterior > producto.precio ? (
                <div class="flex items-baseline gap-2">
                  <span class="text-body-lg text-on-surface-variant/60 line-through">
                    {formatearPrecio(producto.precioAnterior, producto.moneda)}
                  </span>
                  {(() => {
                    const pct = Math.round(((producto.precioAnterior - producto.precio) / producto.precioAnterior) * 100)
                    return pct > 0 ? (
                      <span class="rounded-full bg-error/10 px-2 py-0.5 text-label-sm font-semibold text-error">
                        -{pct}%
                      </span>
                    ) : null
                  })()}
                </div>
              ) : null}
              <p class="font-headline text-display text-primary">
                {formatearPrecio(producto.precio, producto.moneda)}
              </p>
              {producto.precioAnterior && producto.precioAnterior > producto.precio && (
                <p class="mt-1 text-label-sm text-secondary">Gran descuento</p>
              )}
            </div>

            <div class="mt-4 flex flex-wrap gap-2 text-label-sm text-on-surface-variant">
              <span class="rounded-full bg-surface-container-high px-3 py-1">{producto.tipo}</span>
              <span class="rounded-full bg-surface-container-high px-3 py-1">{producto.categoria}</span>
              {producto.destacado && <span class="rounded-full bg-primary/10 px-3 py-1 text-primary">{t.ficha.destacado}</span>}
            </div>

            {producto.tipo === 'fisico' && (
              <p class:list={["mt-4 text-body-md font-semibold", sinExistencias ? "text-error" : "text-on-surface-variant"]}>
                {sinExistencias
                  ? 'Agotado por ahora'
                  : `${producto.detallesFisicos?.stock} disponibles`}
              </p>
            )}

            {producto.variantes.length > 0 && (
              <div class="mt-5">
                <p class="text-label-md text-on-surface">Elige una opción</p>
                <div id="variantes" class="mt-2 flex flex-wrap gap-2">
                  {producto.variantes.map((v) => (
                    <button
                      type="button"
                      class="variante rounded-xl border-2 border-outline-variant/60 px-3 py-2 text-left text-body-sm transition hover:border-primary"
                      data-variante={v.id}
                      data-stock={v.stock}
                      disabled={v.stock <= 0}
                    >
                      <span class="block font-semibold text-on-surface">{v.valor}</span>
                      <span class="block text-label-sm text-on-surface-variant">{v.nombre} · {v.stock > 0 ? `${v.stock} disp.` : 'agotado'}</span>
                    </button>
                  ))}
                </div>
              </div>
            )}

            <div class="mt-6 flex flex-col gap-3">
              <button
                type="button"
                id="anadir-carrito"
                data-producto={producto.id}
                disabled={sinExistencias}
                class="inline-flex items-center justify-center gap-2 rounded-full bg-primary px-6 py-3 text-body-lg font-semibold text-on-primary transition hover:bg-primary-container disabled:cursor-not-allowed disabled:opacity-50"
              >
                {sinExistencias ? 'No disponible' : t.ficha.anadirCarrito}
              </button>
              <a href={`/vendedor/${producto.vendedorSlug}`} class="inline-flex items-center justify-center gap-2 rounded-full border border-outline-variant px-6 py-3 text-body-lg font-semibold text-on-surface transition hover:border-primary">
                {t.ficha.verVendedor}
              </a>
              <p id="aviso-carrito" class="hidden text-center text-body-sm text-secondary" role="status"></p>
            </div>

            {producto.detallesDigitales?.demoUrl && (
              <a href={producto.detallesDigitales.demoUrl} target="_blank" rel="noopener noreferrer" class="mt-3 block text-center text-body-md text-primary hover:underline">
                Ver demostración
              </a>
            )}

            {mediosListos.length > 0 && (
              <section class="mt-8">
                <h2 class="font-headline text-headline-sm text-on-surface">Cómo pagar</h2>
                <div class="mt-3 space-y-3">
                  {mediosListos.map((m) => (
                    <QrCuenta
                      etiqueta={m.etiqueta}
                      dato={m.dato!}
                      instrucciones={m.instrucciones}
                    />
                  ))}
                </div>
                <p class="mt-4 text-body-sm text-on-surface-variant/80">{t.ficha.avisoPago}</p>
              </section>
            )}

            <dl class="mt-8 grid gap-4 rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-4 text-body-sm text-on-surface-variant sm:grid-cols-2">
              <div>
                <dt class="font-semibold text-on-surface">{t.ficha.publicado}</dt>
                <dd>{formatearFecha(producto.fechaPublicacion)}</dd>
              </div>
              <div>
                <dt class="font-semibold text-on-surface">{t.ficha.actualizado}</dt>
                <dd>{formatearFecha(producto.fechaActualizacion)}</dd>
              </div>
            </dl>
          </aside>
        </article>
      )}
    </div>
  </section>
</Base>

<script>
  import { anadir } from '../../lib/carrito-cliente'

  const principal = document.getElementById('imagen-principal') as HTMLImageElement | null
  document.querySelectorAll<HTMLButtonElement>('.mini').forEach((b) => {
    b.addEventListener('click', () => {
      const src = b.dataset.src
      if (principal && src) principal.src = src
      document.querySelectorAll('.mini').forEach((x) => x.classList.remove('border-primary'))
      b.classList.add('border-primary')
    })
  })

  let varianteId: number | null = null
  document.querySelectorAll<HTMLButtonElement>('.variante').forEach((b) => {
    b.addEventListener('click', () => {
      varianteId = Number(b.dataset.variante)
      document.querySelectorAll('.variante').forEach((x) => x.classList.remove('border-primary', 'bg-primary/5'))
      b.classList.add('border-primary', 'bg-primary/5')
    })
  })

  const boton = document.getElementById('anadir-carrito') as HTMLButtonElement | null
  const aviso = document.getElementById('aviso-carrito')
  boton?.addEventListener('click', async () => {
    const productoId = Number(boton.dataset.producto)
    boton.disabled = true
    const r = await anadir(productoId, 1, varianteId)
    boton.disabled = false
    if (aviso) {
      aviso.textContent = r.ok ? 'Añadido al carrito.' : r.mensaje
      aviso.classList.remove('hidden')
      aviso.classList.toggle('text-error', !r.ok)
      aviso.classList.toggle('text-secondary', r.ok)
    }
  })
</script>
