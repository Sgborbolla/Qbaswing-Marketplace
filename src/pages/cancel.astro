---
/**
 * Pago cancelado.
 *
 * ============================================================================
 *  CANCELAR NO ES LO MISMO QUE FALLAR
 * ============================================================================
 * Cuando el comprador cancela, el dinero NO se cobró. Se registra la
 * transacción como `rechazado` en la base y el carrito se conserva intacto, para
 * que pueda reintentar con otra pasarela.
 *
 * Esto importa porque en Cuba el pago suele fallar por motivos concretos: la
 * pasarela no tiene saldo, la tarjeta rebotó, el cambio de moneda no cuadra.
 * Un mensaje de "algo salió mal" manda al cliente a pensar que el marketplace
 * está roto. Este mensaje le dice exactamente qué pasó y qué puede hacer.
 *
 * La lista de motivos viene de la query, no se adivina: el Worker la arma
 * segun por qué se canceló.
 *
 * ============================================================================
 *  LO QUE NO HACE
 * ============================================================================
 * No confirma ni desmiente el pago. Si el comprador canceló pero el webhook
 * llegó después (carrera entre el navegador y la pasarela), el estado real lo
 * tiene el Worker. Por eso el texto dice "si ya habías pagado, contacta" en vez
 * de afirmar que no se cobró nada.
 */
import Icono from '../components/Icono.astro'
import Miniatura from '../components/Miniatura.astro'
import Layout from '../layouts/Base.astro'
import Logo from '../components/Logo.astro'
import { diccionarioDe, rellenar } from '../i18n/diccionario'
import { backendConfigurado } from '../lib/api'

const t = diccionarioDe(Astro.currentLocale ?? 'es')

const ref = Astro.url.searchParams.get('ref') ?? ''
const motivo = Astro.url.searchParams.get('motivo') ?? ''

/**
 * Motivos conocidos, con su texto. Si el motivo no esta en la lista, se muestra
 * el generico: inventar una explicacion para un motivo desconocido es peor que
 * no explicarlo.
 */
const MOTIVOS: Record<string, string> = {
  saldo: t.fallo.motivoSaldo,
  rechazo: t.fallo.motivoRechazo,
  timeout: t.fallo.motivoTimeout,
  usuario: t.fallo.motivoUsuario,
  cambio: t.fallo.motivoCambio,
}

const explicacion = MOTIVOS[motivo] ?? t.fallo.sinMotivo

const ICONO = {
  cerrar: 'cancel',
  reintentar: 'refresh',
  volver: 'arrow_back',
} as const
---

<Layout
  title={t.fallo.titulo}
  descripcion={t.fallo.descripcion}
>
  <section class="container-page flex min-h-[70vh] items-center justify-center py-16">
    <div class="w-full max-w-lg text-center">
      <div class="flex justify-center">
        <Logo altura={64} alt="" />
      </div>

      <h1 class="mt-6 font-headline text-headline-md text-on-surface">
        {t.fallo.noSeCompleto}
      </h1>

      <p class="mt-3 text-body-lg text-on-surface-variant">{explicacion}</p>

      {
        ref && (
          <p class="mt-4 inline-block rounded-md bg-surface-container px-3 py-1.5 font-mono text-code text-on-surface-variant">
            {rellenar(t.fallo.referencia, { ref })}
          </p>
        )
      }

      {/*
        Aviso sobre la carrera entre el navegador y la pasarela. Es real: si el
        comprador cierra la pestana justo cuando QvaPay confirma, el pago
        puede haberse cobrado igual. Decirlo evita un reembolso innecesario.
      */}
      <p
        class="mt-6 rounded-md border border-outline-variant bg-surface-container-low px-4 py-3 text-left text-body-sm text-on-surface-variant"
        role="note"
      >
        {t.fallo.avisoCarrera}
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <a
          href="/carrito"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-primary px-6 py-3 text-label-md font-semibold text-on-primary transition-opacity hover:opacity-90"
        >
          <Icono nombre={ICONO.reintentar} class="text-label-md" />
          {t.fallo.intentarDeNuevo}
        </a>
        <a
          href="/productos"
          class="inline-flex items-center justify-center gap-2 rounded-full border border-outline px-6 py-3 text-label-md font-semibold text-primary transition-colors hover:bg-surface-container"
        >
          <Icono nombre={ICONO.volver} class="text-label-md" />
          {t.fallo.volverCatalogo}
        </a>
      </div>

      {/*
        Solo se ofrece ayuda si hay backend: sin el, un formulario de soporte
        no tiene a donde enviar nada.
      */}
      {
        backendConfigurado && (
          <p class="mt-8 text-body-sm text-on-surface-variant">
            {t.fallo.necesitasAyuda}{' '}
            <a href="/contacto" class="font-semibold text-primary underline">
              {t.fallo.escribinos}
            </a>
          </p>
        )
      }

      <div class="mt-10 flex items-center justify-center gap-3" aria-hidden="true">
        <Miniatura nombre="ropa" ancho={44} />
        <Miniatura nombre="software" ancho={44} />
        <Miniatura nombre="calzado" ancho={44} />
      </div>
    </div>
  </section>
</Layout>
