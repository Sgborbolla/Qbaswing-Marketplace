---
/**
 * Política de privacidad.
 *
 * No promete lo que no hace: no rastrea a terceros con fines publicitarios,
 * no comparte datos sensibles, y lo que guarda es lo minimo para que la
 * compra y la descarga funcionen.
 */
import Base from '../layouts/Base.astro'
import Miniatura from '../components/Miniatura.astro'
import { diccionarioDe } from '../i18n/diccionario'

const t = diccionarioDe(Astro.currentLocale ?? 'es')
---

<Base title={t.privacidad.titulo}>
  <section class="w-full py-space-xl">
    <div class="container-page max-w-4xl">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h1 class="font-headline text-headline-lg text-on-surface">
            {t.privacidad.titulo}
          </h1>
          <p class="mt-2 text-body-sm text-on-surface-variant">
            {t.privacidad.ultimaActualizacion} {new Date().toLocaleDateString('es-CU')}
          </p>
        </div>
        <Miniatura nombre="cuenta" ancho={64} />
      </div>

      <div class="mt-8 space-y-8 text-body-md text-on-surface-variant">
        <section>
          <h2 class="font-headline text-title-lg font-semibold text-on-surface">
            {t.privacidad.queRecopilamos}
          </h2>
          <p class="mt-2">
            {t.privacidad.queRecopilamosTexto}
          </p>
        </section>

        <section>
          <h2 class="font-headline text-title-lg font-semibold text-on-surface">
            {t.privacidad.usoDatos}
          </h2>
          <p class="mt-2">
            {t.privacidad.usoDatosTexto}
          </p>
        </section>

        <section>
          <h2 class="font-headline text-title-lg font-semibold text-on-surface">
            {t.privacidad.cookies}
          </h2>
          <p class="mt-2">
            {t.privacidad.cookiesTexto}
          </p>
        </section>

        <section>
          <h2 class="font-headline text-title-lg font-semibold text-on-surface">
            {t.privacidad.comparticion}
          </h2>
          <p class="mt-2">
            {t.privacidad.comparticionTexto}
          </p>
        </section>

        <section>
          <h2 class="font-headline text-title-lg font-semibold text-on-surface">
            {t.privacidad.seguridad}
          </h2>
          <p class="mt-2">
            {t.privacidad.seguridadTexto}
          </p>
        </section>

        <section>
          <h2 class="font-headline text-title-lg font-semibold text-on-surface">
            {t.privacidad.derechos}
          </h2>
          <p class="mt-2">
            {t.privacidad.derechosTexto}
          </p>
        </section>
      </div>
    </div>
  </section>
</Base>
