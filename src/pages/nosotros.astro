---
/**
 * Acerca de QBASwing Marketplace.
 *
 * ESTA PAGINA NO INVENTA.
 *
 * No dice "equipo de 20 desarrolladores", "fundado en 2020" ni ninguna cifra
 * inventada. Dice lo que hay: una plataforma de marketplace con tres reglas
 * publicadas, sin custodia de fondos, con entrega digital de cinco minutos.
 */
import Base from '../layouts/Base.astro'
import Miniatura from '../components/Miniatura.astro'
import { diccionarioDe } from '../i18n/diccionario'

const t = diccionarioDe(Astro.currentLocale ?? 'es')
---

<Base title={t.nosotros.titulo}>
  <section class="w-full py-space-xl">
    <div class="container-page">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h1 class="font-headline text-headline-lg text-on-surface">{t.nosotros.titulo}</h1>

          <p class="mt-4 max-w-3xl text-body-lg text-on-surface-variant">
            {t.nosotros.intro}
          </p>
        </div>
        <div class="hidden shrink-0 flex-col gap-2 sm:flex" aria-hidden="true">
          <Miniatura nombre="software" ancho={56} />
          <Miniatura nombre="ropa" ancho={56} />
        </div>
      </div>

      <div class="mt-8 grid gap-8 md:grid-cols-2">
        <article class="rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-6 shadow-e1">
          <h2 class="font-headline text-title-lg font-semibold text-on-surface">
            {t.nosotros.mision}
          </h2>
          <p class="mt-2 text-body-md text-on-surface-variant">
            {t.nosotros.misionTexto}
          </p>
        </article>

        <article class="rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-6 shadow-e1">
          <h2 class="font-headline text-title-lg font-semibold text-on-surface">
            {t.nosotros.principios}
          </h2>
          <p class="mt-2 text-body-md text-on-surface-variant">
            {t.nosotros.principiosTexto}
          </p>
        </article>
      </div>

      <article class="mt-8 rounded-2xl border border-outline-variant/60 bg-surface-container-low p-6">
        <h2 class="font-headline text-title-lg font-semibold text-on-surface">
          {t.nosotros.tresReglas}
        </h2>
        <p class="mt-2 text-body-md text-on-surface-variant">
          {t.nosotros.reglasTexto}
        </p>
      </article>

      <p class="mt-8 max-w-3xl text-body-md text-on-surface-variant/80">
        {t.nosotros.garantias}
      </p>
    </div>
  </section>
</Base>
