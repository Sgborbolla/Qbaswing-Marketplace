---
/**
 * Página de contacto, estática.
 *
 * No inventa ningún número, correo o dirección: solo muestra qué canales
 * existen según los datos de la plataforma. Si el Owner los deja vacíos, no
 * aparece nada: ese es el estado vacío real.
 */
import Icono from '../components/Icono.astro'
import Miniatura from '../components/Miniatura.astro'
import Base from '../layouts/Base.astro'
import { diccionarioDe } from '../i18n/diccionario'

const t = diccionarioDe(Astro.currentLocale ?? 'es')
---

<Base title={t.contacto.titulo}>
  <section class="w-full py-space-xl">
    <div class="container-page max-w-3xl">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h1 class="font-headline text-headline-lg text-on-surface">{t.contacto.titulo}</h1>

          <p class="mt-4 text-body-lg text-on-surface-variant">
            {t.contacto.intro}
          </p>
        </div>
        <Miniatura nombre="servicio" ancho={64} />
      </div>

      <article class="mt-8 rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-6 shadow-e1">
        <h2 class="font-headline text-title-md font-semibold text-on-surface">
          {t.contacto.comoContactar}
        </h2>
        <p class="mt-2 text-body-md text-on-surface-variant">
          {t.contacto.gestion}
        </p>
        <a
          href="/faq"
          class="mt-4 inline-flex items-center gap-1.5 text-label-lg font-semibold text-primary transition-colors hover:text-primary-container"
        >
          {t.contacto.verFaq}
          <Icono nombre="arrow_forward" class="text-[18px]" />
        </a>
      </article>

      <p class="mt-6 text-body-sm text-on-surface-variant/70">
        {t.contacto.aviso}
      </p>
    </div>
  </section>
</Base>
