---
/**
 * Layout raiz. Toda pagina pasa por aca.
 *
 * Decisiones:
 * - Las fuentes se cargan con `preconnect` y una sola peticion por familia.
 *   Los mockups de Stitch cargaban Material Symbols dos veces, con dos
 *   variantes distintas del mismo recurso.
 * - Se declara un solo `<style>` para los simbolos en vez de repetirlo por
 *   componente.
 */
import '../styles/global.css'
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'

interface Props {
  title: string
  descripcion?: string
  /** Ruta del color de tema para el navegador en moviles. */
  themeColor?: string
  /** Oculta el header en pantallas de tipo panel. */
  sinHeader?: boolean
}

const {
  title,
  descripcion = 'QBASwing Marketplace: software, plantillas, menu digitales, artesanias y productos fisicos de Cuba y el mundo.',
  themeColor = '#f8f9ff',
  sinHeader = false,
} = Astro.props

// Nombre de la pagina: "Detalle | QBASwing" salvo en la home.
const tituloCompleto = title === 'QBASwing Marketplace' ? title : `${title} · QBASwing`
const urlCanonica = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin)
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={themeColor} />

    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={urlCanonica} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="QBASwing Marketplace" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:locale" content="es" />
    <meta name="twitter:card" content="summary_large_image" />

    <!--
      Las imagenes de los mockups de Stitch apuntan a lh3.googleusercontent.com
      con URLs temporales. No se referencian aca a proposito: cuando existan los
      assets reales (en public/ o servidos por R2), se agrega og:image.
    -->

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!--
      Una sola peticion por familia. Material Symbols se pide con el eje `opsz`
      porque los mockups usan tamanos de 14 a 32 px, y sin `opsz` el navegador
      no puede ajustar el grosor del trazo.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
    />
  </head>
  <body class="min-h-dvh flex flex-col bg-background text-on-surface antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-on-primary"
    >
      Saltar al contenido
    </a>

    {!sinHeader && <Header />}

    <main id="contenido" class="flex-1 w-full">
      <slot />
    </main>

    {!sinHeader && <Footer />}
  </body>
</html>
