# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Base del backend. Sin este valor el sitio muestra estados vacios en lugar de
# datos ficticios (ver src/lib/api.ts).
#
# Cloudflare: si expones el backend como Worker, la URL tendra esta forma.
#   PUBLIC_API_BASE=https://api.qbaswing-marketplace.workers.dev
PUBLIC_API_BASE=

# URL del Worker, cuando el backend se despliegue por separado de Pages.
# Se separa de PUBLIC_API_BASE porque el Worker y el sitio suelen vivir en
# dominios distintos y el CORS hay que configurarlos por separado.
PUBLIC_CF_WORKER_URL=

# Dominio publico del sitio. Se usa en astro.config.mjs (campo `site`) para
# generar el sitemap y las URLs absolutas de Open Graph.
# Cloudflare Pages asigna uno por defecto: <proyecto>.pages.dev
PUBLIC_SITE_URL=https://qbaswing-marketplace.pages.dev
